{
  "entities": {
    "User": {
      "title": "User",
      "description": "Utilisateurs de la plateforme doctorale USMBA avec contrôle des rôles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 100 },
        "role": { "type": "string", "enum": ["candidate", "professor", "admin"] },
        "title": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    },
    "CandidateProfile": {
      "title": "CandidateProfile",
      "description": "Profil académique et civil réutilisable du candidat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "firstName": { "type": "string", "maxLength": 60 },
        "lastName": { "type": "string", "maxLength": 60 },
        "cin": { "type": "string", "maxLength": 20 },
        "cne": { "type": "string", "maxLength": 20 },
        "birthDate": { "type": "string" },
        "nationality": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 25 },
        "email": { "type": "string", "format": "email" },
        "masterDegree": { "type": "string", "maxLength": 150 },
        "masterUniversity": { "type": "string", "maxLength": 150 },
        "masterGrade": { "type": "number" },
        "masterMention": { "type": "string", "maxLength": 30 },
        "pfeTitle": { "type": "string", "maxLength": 250 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "firstName", "lastName", "cin", "cne", "email"]
    },
    "CandidateApplication": {
      "title": "CandidateApplication",
      "description": "Dossier de candidature indépendant pour un sujet de thèse",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topicId": { "type": "string" },
        "topicCode": { "type": "string", "maxLength": 50 },
        "topicTitle": { "type": "string", "maxLength": 250 },
        "candidateId": { "type": "string" },
        "candidateName": { "type": "string", "maxLength": 100 },
        "candidateEmail": { "type": "string", "format": "email" },
        "cne": { "type": "string", "maxLength": 20 },
        "cin": { "type": "string", "maxLength": 20 },
        "masterDegree": { "type": "string", "maxLength": 150 },
        "submissionDate": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["draft", "incomplete", "pending_review", "correction_requested", "waitlisted", "accepted", "rejected"]
        },
        "isDraft": { "type": "boolean" },
        "statementOfPurpose": { "type": "string", "maxLength": 4000 },
        "rejectionReason": { "type": "string", "maxLength": 1000 },
        "correctionMessage": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "topicId", "candidateId", "candidateEmail", "status", "submissionDate"]
    },
    "ThesisTopic": {
      "title": "ThesisTopic",
      "description": "Offre de sujet de recherche doctorale USMBA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 300 },
        "professorName": { "type": "string", "maxLength": 100 },
        "professorEmail": { "type": "string", "format": "email" },
        "laboratory": { "type": "string", "maxLength": 150 },
        "institution": { "type": "string", "maxLength": 150 },
        "academicYear": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["open", "closed", "under_review"] },
        "isOfficialPublication": { "type": "boolean" }
      },
      "required": ["id", "code", "title", "professorName", "laboratory", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Données utilisateur et gestion des permissions de rôles"
    },
    "/candidateProfiles/{userId}": {
      "schema": "CandidateProfile",
      "description": "Profils personnels et académiques réutilisables"
    },
    "/applications/{applicationId}": {
      "schema": "CandidateApplication",
      "description": "Dossiers de candidatures doctorales indépendants"
    },
    "/topics/{topicId}": {
      "schema": "ThesisTopic",
      "description": "Offre officielle de recherche doctorale"
    }
  }
}
